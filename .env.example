# Keep default config on mock if you want.
# You can call `--provider router` from the CLI for live model tests.
# Switch config/default.toml to router only when you want router mode to become the default.

# Primary domestic provider
DASHSCOPE_API_KEY=

# Optional domestic fallback
MOONSHOT_API_KEY=

# Optional cost-oriented fallback
DEEPSEEK_API_KEY=

# Optional overseas fallback
OPENAI_API_KEY=

# DingTalk delivery
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=

# DingTalk alerts
DINGTALK_ALERT_WEBHOOK_URL=
DINGTALK_ALERT_SECRET=
